# ─────────────────────────────────────────────────────────────
# F.R.I.D.A.Y. & Torn Sentinel - Application Environment Config
# ─────────────────────────────────────────────────────────────
# IMPORTANT:
# User-specific Torn API keys are NEVER stored in this file or globally!
# Each player links their own Limited Access key securely via Discord (/linkkey)
# or the web vault. User credentials are encrypted with AES-256-GCM and stored
# in MongoDB Atlas with per-user data isolation.
# ─────────────────────────────────────────────────────────────

# Application-Level Secrets (Backend Only)
PORT=3000
GLOBAL_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
MONGODB_URI=YOUR_MONGODB_ATLAS_URI_HERE
APP_SECRET=YOUR_RANDOM_VAULT_ENCRYPTION_SECRET_HERE

# Optional Application-Level Failover AI Keys (Shared system services only)
OPENROUTER_API_KEY=
GEMINI_API_KEYS=
